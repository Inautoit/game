{
  "name": "facturas-electricidad",
  "version": "1.0.0",
  "private": true,
  "description": "Web app para gestionar, generar (desde plantilla Excel) y enviar por correo las facturas de un autónomo.",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
