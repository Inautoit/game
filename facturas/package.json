  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.18.1",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.12"
  }
}
