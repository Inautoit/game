# Copia este archivo como .env y rellena lo que necesites.

# Puerto de la web (http://localhost:3000)
PORT=3000

# --- Iniciar sesión con Microsoft (Outlook / Hotmail / Live / Office 365) ---
# Ver README.md → "Conectar tu correo de Outlook". Si lo dejas vacío,
# solo estará disponible el inicio con correo + contraseña (SMTP).
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Solo si publicas la web en un dominio propio:
# MS_REDIRECT_URI=https://facturas.midominio.es/auth/microsoft/callback

# Correos que pueden entrar (separados por comas). Si lo dejas vacío,
# la primera cuenta que inicie sesión queda como única dueña de la app.
ALLOWED_EMAILS=

# Carpeta donde se guardan la base de datos y la plantilla (por defecto ./data)
# DATA_DIR=./data

# Si publicas la web con HTTPS detrás de un proxy (nginx, Caddy...):
# TRUST_PROXY=1
# COOKIE_SECURE=1

# Ruta de LibreOffice si no se encuentra automáticamente (para generar PDF)
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
