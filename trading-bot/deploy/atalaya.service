# Bot de trading 24/7 (opera con dinero simulado y sirve el panel en el puerto 8080)
[Unit]
Description=Atalaya Bot - trading continuo
After=network-online.target
Wants=network-online.target

[Service]
User=atalaya
WorkingDirectory=/opt/atalaya/trading-bot
EnvironmentFile=-/etc/atalaya.env
ExecStart=/opt/atalaya/venv/bin/python -W ignore main.py run --port 8080
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
