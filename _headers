# Cabeceras para Cloudflare Pages
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(self), gyroscope=(self)

# El HTML y el service worker siempre frescos: así un despliegue se ve al instante.
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache

# Assets inmutables (el .glb son 3 MB: se cachea un año)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/src/*
  Cache-Control: public, max-age=3600
