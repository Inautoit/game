# Supabase (opcional en local: sin estas variables la app funciona en modo local con IndexedDB)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para scripts de importacion y jobs de servidor. Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Protege /api/prices/refresh
PRICE_REFRESH_SECRET=

# eBay Browse API (opcional)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_ES
