# Supabase (opcional). Sin estas variables la app funciona en modo local:
# todo se guarda en IndexedDB de ese navegador.
# Al ser un sitio estático, estas dos son públicas por definición: la clave
# anónima está pensada para ir en el cliente y quien protege los datos es RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Colección activa (por defecto: liga-2025-26)
NEXT_PUBLIC_COLLECTION_SLUG=

# Solo para el script de importación del catálogo, en tu máquina.
# Nunca se sube a Cloudflare Pages: no hay servidor donde esconderla.
SUPABASE_SERVICE_ROLE_KEY=

# El Worker opcional de precios NO lee este fichero. Sus secretos se suben con
# `npx wrangler secret put ...` — ver worker/wrangler.jsonc.
